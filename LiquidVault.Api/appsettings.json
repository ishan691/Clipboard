{
  "Logging": { "LogLevel": { "Default": "Information", "Microsoft.AspNetCore": "Warning" } },
  "AllowedHosts": "*",
  "UploadSettings": {
    "StoragePath": "Uploads",
    "MaxFileSizeBytes": 10737418240,
    "MaxBatchFiles": 50,
    "MaxTextBytes": 1048576,
    "ExpirationHours": 24,
    "CleanupIntervalSeconds": 300
  }
}
